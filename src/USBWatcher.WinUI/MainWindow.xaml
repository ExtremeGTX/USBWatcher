<Window
    x:Class="USBWatcher.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:USBWatcher.WinUI"
    Title="USBWatcher">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="ColumnResizeThumbStyle" TargetType="Thumb">
                <Setter Property="Width" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <local:ColumnResizeSurface Background="Transparent">
                                <Border Width="1" Height="18" HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </local:ColumnResizeSurface>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="20,8,148,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="44" Height="44" Source="ms-appx:///Assets/Usb96.png" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="USBWatcher" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Monitor USB and serial devices" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="SettingsButton" Width="46" Height="42" Padding="0"
                    Click="SettingsButton_Click" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="14,0,14,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" MinHeight="220" />
                <RowDefinition Height="5*" MinHeight="260" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              SizeChanged="DeviceViewport_SizeChanged">
                <Grid x:Name="DeviceTable" Width="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="DeviceHeaders" Grid.Row="0" Padding="14,0" ColumnSpacing="12" BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Alias" Tag="0" Click="SortDevices_Click" HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" />
                        <Button Grid.Column="1" Content="Device Name" Tag="1" Click="SortDevices_Click" HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" />
                        <Button Grid.Column="2" Content="Port" Tag="2" Click="SortDevices_Click" HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" />
                        <Button Grid.Column="3" Content="Serial Number" Tag="3" Click="SortDevices_Click" HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" />
                        <Thumb Tag="0" DragDelta="DeviceColumn_DragDelta" Style="{StaticResource ColumnResizeThumbStyle}" ToolTipService.ToolTip="Drag to resize Alias" />
                        <Thumb Grid.Column="1" Tag="1" DragDelta="DeviceColumn_DragDelta" Style="{StaticResource ColumnResizeThumbStyle}" ToolTipService.ToolTip="Drag to resize Device Name" />
                        <Thumb Grid.Column="2" Tag="2" DragDelta="DeviceColumn_DragDelta" Style="{StaticResource ColumnResizeThumbStyle}" ToolTipService.ToolTip="Drag to resize Port" />
                        <Thumb Grid.Column="3" Tag="3" DragDelta="DeviceColumn_DragDelta" Style="{StaticResource ColumnResizeThumbStyle}" ToolTipService.ToolTip="Drag to resize Serial Number" />
                    </Grid>
                    <ListView x:Name="DevicesList" Grid.Row="1" ItemsSource="{x:Bind Devices}" SelectionMode="Single"
                              DoubleTapped="DevicesList_DoubleTapped" IsItemClickEnabled="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="14,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Background="Transparent" Loaded="DeviceRow_Loaded">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Rename" Tag="{Binding}" Click="RenameDevice_Click" />
                                            <MenuFlyoutItem Text="Restore default name" Tag="{Binding}"
                                                            IsEnabled="{Binding HasCustomName}"
                                                            Click="RestoreDeviceName_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE88E;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Alias}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Port}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SerialNumber}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="22" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Recent Events" Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="2" Content="Clear" Click="ClearEvents_Click" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="14,0" ColumnSpacing="12" BorderThickness="0,1,0,1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Time" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Device" Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="Event" Style="{StaticResource ColumnHeaderStyle}" />
                    </Grid>
                    <TreeView x:Name="EventsTree" Grid.Row="2" ItemsSource="{x:Bind Events}">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <TreeViewItem ItemsSource="{Binding Children}"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              MinHeight="28" Padding="0">
                                    <Grid MinHeight="28" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
